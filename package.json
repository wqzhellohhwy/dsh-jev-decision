{
  "name": "@local/dsh-jev-decision",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "把基元律动的 JEV 决策模型（NeoHorse-Jev-4B）接成三个工具：jev_noul 判断概率、jev_choice 多选一、jev_score 评分。决策模型非对话模型，走 /v1/decision 专用接口。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2"
  }
}
